# UCIe regression list — run via `make regress` in verif/sim.
# Each line: <make-target> <expected-PASS-substring>
lint LINT
sim SMOKE
flit FLIT
flit_path FLITPATH
flit_stress FLITSTRESS
link_mgmt LINKMGMT
lane_pll LANEPLL
ahb_cfg AHBCFG
ack_xchg ACKXCHG
xcross XCROSS
linkinit_xchg LINKINITXCHG
d2d_dual D2DDUAL PASS WPF=7
d2d_dual256 D2DDUAL PASS WPF=32
formal FORMAL_OK
link LINKBRINGUP
flit_dual FLITDUAL
